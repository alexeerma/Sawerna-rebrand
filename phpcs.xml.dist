<?xml version="1.0"?>
<ruleset name="Sawerna Theme">
	<description>WordPress + WooCommerce coding standards for the Sawerna theme.</description>

	<arg value="ps"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<!-- Dead forks of sawerna-core files, not loaded. -->
	<exclude-pattern>/inc/(wishlist|shop-filters|product-card|single-product|attribute-swatches|html-blocks|menu-html-blocks)\.php</exclude-pattern>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs">
		<severity>3</severity>
	</rule>
	<rule ref="WooCommerce-Core">
		<!-- Theme text domain is sawerna; WC overrides keep the woocommerce domain for core strings. -->
		<exclude name="WooCommerce.Commenting.CommentHooks"/>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sawerna"/>
				<element value="woocommerce"/>
			</property>
		</properties>
	</rule>
	<!-- Theme option sanitizers: each runs sanitize_text_field/absint/esc_url_raw etc. per field. -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="sawerna_about_sanitize_options"/>
				<element value="sawerna_contact_sanitize_options"/>
				<element value="sawerna_sanitize_homepage_slides"/>
				<element value="sawerna_sanitize_homepage_wide_slides"/>
				<element value="sawerna_sanitize_homepage_narrow_slides"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sawerna"/>
			</property>
		</properties>
	</rule>
	<!--
	Template files are loaded via load_template()/wc_get_template() inside a function scope,
	so their variables are not globals. WooCommerce overrides must use WC core hook names.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/woocommerce/*</exclude-pattern>
		<exclude-pattern>/template-parts/*</exclude-pattern>
		<exclude-pattern>/[^/]+\.php$</exclude-pattern>
		<include-pattern>/functions\.php$</include-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>/woocommerce/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>
</ruleset>
